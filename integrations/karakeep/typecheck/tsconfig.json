{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "baseUrl": ".",
    "paths": {
      "@karakeep/shared/search": ["./vendor/karakeep-shared/search.d.ts"],
      "@karakeep/shared/plugins": ["./vendor/karakeep-shared/plugins.d.ts"]
    }
  },
  "include": ["../search-facetmark/**/*.ts", "vendor/**/*.d.ts"],
  "exclude": ["node_modules"]
}
