# https://editorconfig.org
# The codebase is hand-formatted; `ruff format` is deliberately not run.
# These rules only cover what an editor can get wrong without being asked.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{js,jsx,ts,tsx,json,jsonc,yml,yaml,css,html}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{jsonl,ndjson}]
# One record per line; wrapping would corrupt the file.
max_line_length = off

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[LICENSE]
insert_final_newline = false
