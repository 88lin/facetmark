# python
__pycache__/
*.py[cod]
.venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# node
node_modules/
extension/dist/
extension/*.zip

# local data - never commit a bookmark library or an index
data/
*.db
*.db-wal
*.db-shm
*.html
!extension/src/*.html
# The web UI shipped inside the wheel. Without this negation `git add` skips it
# and, worse, hatchling honours the ignore file when selecting wheel contents,
# so `pip install facetmark` would serve a 404 at /app.
!src/facetmark/web/*.html
# The published site. `scripts/publish_pages.py` flattens docs/landing/ into
# docs/, and without this negation every page it writes is invisible to
# `git add`, so publishing quietly needs -f and -f then sweeps in every cache
# directory it walks past.
!docs/*.html
# The pattern above did not stop `favorites_2026_8_4.html`: it arrived through
# GitHub's web uploader, which commits directly and never consults .gitignore.
# Named here as well, so that `git add` at least cannot bring it back.
favorites_*.html
bookmarks*.html
pairing-token.txt

# editors / os
.vscode/
.idea/
.DS_Store

# landing page (GitHub Pages)
!docs/landing/*.html
!docs/landing/*.css
