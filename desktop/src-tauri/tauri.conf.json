{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Facetmark",
  "version": "2.1.1",
  "identifier": "io.github.88lin.facetmark",
  "build": { "frontendDist": "../splash" },
  "app": {
    "windows": [{ "label": "loading", "title": "Facetmark", "width": 500, "height": 360, "resizable": false, "center": true, "backgroundColor": "#e9eff5" }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/facetmark-service"],
    "resources": { "binaries/_internal/": "_internal/" },
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Facetmark"
      }
    }
  }
}
