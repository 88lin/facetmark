.github
.venv
venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
tests
eval
scripts
docs
integrations
extension
desktop
.desktop-build
**/node_modules
**/playwright-report
**/test-results
**/screenshots
agent-ctx
*.db
*.db-*
*.sqlite
*.log
Dockerfile
compose.yml
.dockerignore
