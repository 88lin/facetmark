{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Imports name the file that is actually on disk (`./api.ts`), so the same
    // source that esbuild bundles can also be run unmodified by `node
    // --experimental-strip-types`. `erasableSyntaxOnly` keeps it that way: it
    // rejects the handful of constructs -- enums, namespaces, constructor
    // parameter properties -- that need a real compiler rather than a
    // type-deleter, and which node refuses at load time.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["chrome", "node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "build.mjs"]
}
